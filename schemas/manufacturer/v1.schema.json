{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.calos.example/manufacturer/v1",
  "title": "Manufacturer content",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "aliases"],
  "properties": {
    "name": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "he"],
      "properties": {
        "en": {"type": "string", "minLength": 1, "maxLength": 160},
        "he": {"type": "string", "minLength": 1, "maxLength": 160}
      }
    },
    "aliases": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 160}
    }
  }
}
