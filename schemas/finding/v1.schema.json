{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.calos.example/finding/v1",
  "title": "Structured finding display contract (not a configuration kind)",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "severity", "pointer", "message", "stage"],
  "properties": {
    "code": { "type": "string" },
    "severity": { "type": "string", "enum": ["error", "warning", "info"] },
    "pointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": { "value": { "type": "string" } }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key"],
      "properties": {
        "key": { "type": "string" },
        "params": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "value"],
            "properties": {
              "name": { "type": "string" },
              "value": { "type": "string" }
            }
          }
        }
      }
    },
    "stage": { "type": "string" },
    "fix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "params": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "value"],
            "properties": {
              "name": { "type": "string" },
              "value": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
