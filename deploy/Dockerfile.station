FROM python:3.12-slim
WORKDIR /opt/calos
COPY packages/py/calos_domain packages/py/calos_domain
COPY apps/station-agent apps/station-agent
RUN pip install --no-cache-dir ./packages/py/calos_domain ./apps/station-agent
ENV PYTHONDONTWRITEBYTECODE=1
EXPOSE 8001
CMD ["uvicorn", "calos_station_agent.main:app", "--host", "0.0.0.0", "--port", "8001"]
