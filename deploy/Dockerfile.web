FROM node:22-alpine
WORKDIR /opt/calos
RUN corepack enable
COPY package.json pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/package.json
COPY packages/ts/domain-types/package.json packages/ts/domain-types/package.json
RUN pnpm install --no-frozen-lockfile
COPY apps/web apps/web
COPY packages/ts/domain-types packages/ts/domain-types
COPY fixtures/manufacturer fixtures/manufacturer
ARG VITE_ENVIRONMENT_KIND=test
ENV VITE_ENVIRONMENT_KIND=${VITE_ENVIRONMENT_KIND}
RUN pnpm build:web
EXPOSE 4173
CMD ["pnpm", "--filter", "@calos/web", "exec", "vite", "preview", "--host", "0.0.0.0", "--port", "4173"]
