{
  "name": "calos-workspace",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "check:ts": "pnpm --filter @calos/domain-types check && pnpm --filter @calos/web check",
    "build:web": "pnpm --filter @calos/web build",
    "lint:ts": "eslint apps/web/src packages/ts/domain-types/src",
    "format:ts": "prettier --write apps/web/src packages/ts/domain-types/src tests/typing/schema_proof.ts tools/check_schema_vectors.mjs",
    "format:ts:check": "prettier --check apps/web/src packages/ts/domain-types/src tests/typing/schema_proof.ts tools/check_schema_vectors.mjs",
    "test:ts-boundary": "node tools/check_ts_boundary.mjs",
    "test:schema-vectors": "node tools/check_schema_vectors.mjs"
  },
  "devDependencies": {
    "eslint": "10.14.0",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-boundaries": "7.4.0",
    "prettier": "3.9.10",
    "typescript-eslint": "8.72.1"
  }
}
